DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/knowledgebase
POSTGRES_PASSWORD=postgres

#Use below for replacing with openai key do not change the key name
GOOGLE_API_KEY=replace-with-google-ai-studio-key-or-openai-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini/gemini-2.5-flash

#For using openai models use below
#LLM_MODEL=openai/gpt-5.4-mini-2026-03-17

# Optional; defaults to LLM_MODEL. LiteLLM model naming varies by provider.
JUDGE_MODEL=
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
